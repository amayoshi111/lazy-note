{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Incremental build (Issue #580): CI の type-check を高速化するため
       .tsbuildinfo を出力し、actions/cache で再利用する。 */
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo/tsconfig.tsbuildinfo",

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Types */
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  // 本体 (ブラウザ向け) の型チェックからテストファイル (src/**/__tests__/**,
  // src/**/*.test.*, src/**/*.spec.*) を除外し、tsconfig.test.json 側で型チェックする
  // (Issue #667)。一部のテスト (src/lib/__tests__ など) は node:fs / process /
  // __dirname 等の Node.js 互換 API を参照するため、これらを本体に含めると
  // @types/node の ambient globals がブラウザコードへも漏出し、Issue #667 の防衛の
  // 意味が失われる。
  //
  // この exclude により src/ の純粋ブラウザコードから process / Buffer 等の Node.js
  // 互換 API 由来の ambient 型が参照不可になる (tsc エラー化)。
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx"
  ]
}
